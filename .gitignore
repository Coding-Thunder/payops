# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/reports
/test-results
/playwright-report
testcards.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit real secrets, but keep .env.example as the reference
.env*
!.env.example

# DigitalOcean App Platform spec — inlines real secrets (Stripe/Mongo/SMTP).
# Never commit. Keep a sanitised .do/app.example.yaml if a reference is needed.
.do/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build artifacts at ANY depth, not just the repo root.
# The patterns above are root-anchored (leading "/"), so a nested app's
# node_modules/.next stays stageable. That is how 26k files from another
# branch's app once showed up as untracked on this branch. These unanchored
# rules are the backstop — do not add a leading slash to them.
node_modules/
.next/
out/
