# Himanshu deployment — variable reference
#
# TRACKED IN GIT ON PURPOSE, and therefore VALUELESS. It exists so the set of
# variables a deployment needs is reviewable; the real files next to it
# (.env.payops.local / .prod / .test / .smoke) are gitignored and hold the
# values.
#
# Copy this to .env.payops.local and fill it in, or read it as the checklist
# of what the hosting platform must supply in production.


# ── Application identity ────────────────────────────────────────
APP_NAME=
NEXT_PUBLIC_APP_NAME=
APP_URL=
NEXT_PUBLIC_APP_URL=

# ── Database ────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=

# ── Session ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=
COOKIE_NAME=
COOKIE_SECURE=

# ── Stripe — the enabled gateway ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── Credential vault ────────────────────────────────────────────
CREDENTIALS_MASTER_KEY=
CREDENTIALS_KEY_VERSION=

# ── Not configured in this phase ─────────────────────────────
# PayPal is retained in the architecture and switched OFF. It has no
# deployment variables yet and must not be given placeholders here — an empty
# PAYPAL_CLIENT_ID reads as "configured but broken" rather than "not enabled".
# The PayPal enablement phase adds them.
