# RCR Cruise deployment — variable reference
#
# TRACKED IN GIT ON PURPOSE, and therefore VALUELESS. It exists so the set of
# variables a deployment needs is reviewable; the real files next to it
# (.env.payops.local / .prod / .test / .smoke) are gitignored and hold the
# values.
#
# Copy this to .env.payops.local and fill it in, or read it as the checklist
# of what the hosting platform must supply in production.
#
# Select this directory with PAYOPS_ENV_DIR=rcr-env — see README.md.


# ── Application identity ────────────────────────────────────────
# Customer-visible. APP_NAME titles the operator console and the browser tab;
# CUSTOMER_BRAND_NAME is what appears in emails and on the payment pages.
APP_NAME=
NEXT_PUBLIC_APP_NAME=
CUSTOMER_BRAND_NAME=
APP_URL=
NEXT_PUBLIC_APP_URL=

# ── Database ────────────────────────────────────────────────────
# SHARED WITH HIMANSHU, deliberately. RCR Cruise is a second ORGANIZATION
# inside the existing `himanshu-payops` database, not a separate database,
# and the two share one user pool. Isolation is enforced per organization by
# the scope layer, not by separate databases.
MONGODB_URI=
MONGODB_DB=himanshu-payops

# ── Session ─────────────────────────────────────────────────────
# JWT_SECRET must be generated fresh. A shared signing key makes a session
# minted for one deployment verifiable on the other.
JWT_SECRET=
JWT_EXPIRES_IN=
CONSENT_TOKEN_SECRET=
COOKIE_NAME=
COOKIE_SECURE=

# ── Tenancy ─────────────────────────────────────────────────────
# REQUIRED whenever the database holds more than one organization, which is
# the case here: Himanshu and RCR Cruise share `himanshu-payops`.
#
# This pins the deployment to ONE organization. Every request, every payment
# link and every webhook on this process can then only ever act as that
# brand — a hard outer bound that holds even if a selection cookie is wrong.
#
#   RCR Cruise deployment : PAYOPS_ORG_SLUG=rcrcruise
#   Himanshu deployment   : PAYOPS_ORG_SLUG=himanshu
#
# Left unset with several organizations present, the app REFUSES to resolve a
# tenant rather than guessing one — safe, but the console will not load.
PAYOPS_ORG_SLUG=rcrcruise

# ── Organization seed ───────────────────────────────────────────
# What `npm run seed:orgs` writes. SEED_ORGS_SERVICE_TYPES is what makes the
# create-order page show the Flights and Cruises tabs, and is the server-side
# allow-list the create route enforces.
#
# NOTE: the seed makes this organization the compatibility anchor
# (`isDefault`) ONLY if no organization holds it yet. Seeding RCR Cruise into
# the existing Himanshu database therefore creates a NON-default tenant,
# which is correct — the anchor sees unattributed pre-migration history and a
# second tenant must never inherit it.
SEED_ORGS_SLUG=rcrcruise
SEED_ORGS_SERVICE_TYPES=FLIGHT,CRUISE

# ── Stripe ──────────────────────────────────────────────────────
# RCR Cruise's OWN merchant account. Never another deployment's keys —
# payments would settle into the wrong bank account, and refunds and
# disputes would surface against the wrong merchant.
# The deployment-level STRIPE_* variables belong to the COMPATIBILITY ANCHOR
# (Himanshu) and are read only by the default organization. RCR Cruise, being
# a non-default tenant, MUST supply its own namespaced credentials below —
# the resolver refuses rather than falling back, so a missing key fails
# loudly instead of quietly charging Himanshu's merchant account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── RCR Cruise Stripe (namespaced by SEED_ORGS_SLUG) ────────────
# Webhook endpoint to configure in RCR Cruise's Stripe dashboard:
#     https://<rcr-domain>/api/webhooks/stripe/rcrcruise
# Himanshu keeps its existing https://<himanshu-domain>/api/webhooks/stripe
# unchanged — do NOT repoint it.
ORG_RCRCRUISE_STRIPE_SECRET_KEY=
ORG_RCRCRUISE_STRIPE_WEBHOOK_SECRET=

# ── PayPal (optional) ───────────────────────────────────────────
# Namespaced per organization: ORG_<SLUG>_*, where <SLUG> is
# SEED_ORGS_SLUG uppercased with non-alphanumerics as underscores.
# Leave every one of these UNSET until PayPal is actually enabled — an empty
# ORG_..._PAYPAL_CLIENT_ID reads as "configured but broken" rather than "not
# enabled", and produces the wrong failure. Enabling PayPal also means adding
# it to the organization's `payments.enabledProviders`.
#
# Webhook endpoint to configure in RCR Cruise's PayPal dashboard:
#     https://<rcr-domain>/api/webhooks/paypal/rcrcruise
# ORG_RCRCRUISE_PAYPAL_CLIENT_ID=
# ORG_RCRCRUISE_PAYPAL_CLIENT_SECRET=
# ORG_RCRCRUISE_PAYPAL_WEBHOOK_ID=
# Absent means LIVE. Set to "true" only for the PayPal sandbox.
# ORG_RCRCRUISE_PAYPAL_SANDBOX=

# ── Email ───────────────────────────────────────────────────────
# RCR Cruise's own mailbox, so SPF/DKIM align with the brand the customer
# expects to hear from.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional, DEPLOYMENT-WIDE fallback only. On a shared database prefer the
# organization's own `email.cc`, which is set on the Organization document —
# a deployment-wide CC would copy one brand's support inbox on the OTHER
# brand's customer mail.
EMAIL_CC=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── Credential vault ────────────────────────────────────────────
# Envelope-encryption key, generated fresh. Sharing it would let one
# deployment open another's sealed credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY=
CREDENTIALS_KEY_VERSION=
