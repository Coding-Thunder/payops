# =========================================================================
# TraceTxn Admin — standalone super-admin console
# Copy to .env.local for local dev. In production these are set on the
# DigitalOcean "admin" component (see .do/app.example.yaml).
# =========================================================================

# ---- Database (SAME cluster as the main app) ----
MONGODB_URI="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/tracetxn?retryWrites=true&w=majority"
MONGODB_DB="tracetxn"

# ---- Secrets ----
# MUST equal the main app's JWT_SECRET so the "set your password" links
# this console mints validate on the main app's /reset-password route.
JWT_SECRET="REPLACE_WITH_MAIN_APP_JWT_SECRET_MIN_32_CHARS"
# Optional dedicated secret for the admin session cookie. Defaults to
# JWT_SECRET when unset. Rotating it logs every admin out.
ADMIN_SESSION_SECRET=""

# ---- Access control ----
# Comma-separated allow-list of emails permitted to sign in (supports as
# many admins as you want). Everything else is rejected server-side even
# with a valid Google account.
ADMIN_ALLOWLIST="vinayheshwari35@gmail.com,cofounder@tracetxn.com"

# ---- Sessions / OTP tuning ----
ADMIN_SESSION_TTL_HOURS="8"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# ---- Main app URL (for the emailed set-password link) ----
MAIN_APP_URL="https://your-main-app.ondigitalocean.app"

# ---- SMTP (same mailbox as the main app is fine) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_ACCOUNTS="TraceTxn Accounts <accounts@tracetxn.com>"
EMAIL_REPLY_TO=""

# ---- Cookies ----
COOKIE_SECURE="true"
COOKIE_DOMAIN=""

# ---- Firebase (Google sign-in) — same project as the main app ----
# Server: single-line service-account JSON. When unset, Google sign-in is
# disabled and only the email + OTP path works.
FIREBASE_SERVICE_ACCOUNT=""
# Client (public) — all four required for the Google button to render.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# ---- Misc ----
APP_NAME="TraceTxn Admin"
