# =========================================================================
# TraceTxn — environment template
#
# Copy to `.env.local` for development, or paste the values that apply
# into your deployment platform's env-var UI (Vercel, DigitalOcean, etc.).
#
# Required vars (zod refuses to start without these):
#   MONGODB_URI · JWT_SECRET · STRIPE_SECRET_KEY · STRIPE_WEBHOOK_SECRET
#
# Strongly recommended for prod:
#   TRACETXN_MASTER_KEY · NEXT_PUBLIC_APP_URL · COOKIE_SECURE="true"
#
# Optional — set only if you need the feature.
# =========================================================================

# ---------- Application ----------
APP_NAME="TraceTxn"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TraceTxn"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV is set by your runtime (Vercel sets "production" automatically).

# ---------- MongoDB ----------
# Local: mongodb://127.0.0.1:27017/tracetxn
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB="tracetxn"

# ---------- Auth ----------
# Generate per env: openssl rand -base64 64    (must be ≥ 32 chars)
JWT_SECRET=""
COOKIE_NAME="tracetxn_session"
# Required "true" over HTTPS; set "false" only for plain-HTTP local dev.
COOKIE_SECURE="true"
# Optional: cross-subdomain scope, e.g. ".yourdomain.com"
# COOKIE_DOMAIN=""

# ---------- Gateway-credentials encryption ----------
# AES-256 master key. Required the moment ANY org connects Stripe via
# /admin/gateways. Generate fresh per env: openssl rand -base64 32
# Loss of this key locks all encrypted gateway credentials.
TRACETXN_MASTER_KEY=""

# ---------- Stripe ----------
# TEST keys: https://dashboard.stripe.com/test/apikeys
# LIVE keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Endpoint URL pattern: <APP_URL>/api/webhooks/stripe/<orgId>
# Each tenant gets a unique webhook URL after they connect their Stripe.
STRIPE_WEBHOOK_SECRET=""

# ---------- SMTP (Resend is the default outbound relay) ----------
# Outbound mail runs through Resend's SMTP. Zoho continues to own
# inbound + human reply-from-mailbox on root tracetxn.com; the two
# providers run side by side (Resend lives under send.tracetxn.com,
# never touches root MX).
#
# How to get SMTP_PASS:
#   1. Resend dashboard → API Keys → Create
#   2. Permission = Sending access · Domain = tracetxn.com
#   3. Copy the re_… value once and paste below
#
# Leave SMTP_HOST empty to disable email entirely (sends become
# EMAIL_FAILED audit rows; order flow keeps working).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS=""

# Tenant-side catch-all sender (marketing quotation ack + tenant
# commerce mail when Branding.senderEmail is empty). Must sit on the
# verified Resend domain.
EMAIL_FROM="TraceTxn <hello@tracetxn.com>"

# Platform-side account-lifecycle sender (password reset, signup
# welcome, trial events, subscription events, security alerts).
EMAIL_FROM_ACCOUNTS="TraceTxn Accounts <accounts@tracetxn.com>"

# Replies to platform emails route here. Leave blank to default replies
# back to whichever From address sent the mail.
EMAIL_REPLY_TO="support@tracetxn.com"

# ---------- Cloudflare Turnstile (optional) ----------
# Bot-check on /login + /api/quotations. Leave blank to disable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ---------- Microsoft Clarity (optional) ----------
# Session recordings + heatmaps on the PUBLIC MARKETING PAGES ONLY
# (/, /features, /pricing, /security, /contact, /waitlist and the legal
# pages). Never loaded on sign-in, payment, consent, /app/** or /admin/**
# — see src/lib/analytics/clarity.ts for the allow-list and why.
# Leave blank to disable: no script is injected and nothing leaves the
# browser. Project ID: clarity.microsoft.com → Settings → Overview.
# Public by necessity (the browser needs it) and non-secret — it authorises
# nothing. Still not committed, per this file's convention: real values live
# in the DigitalOcean env panel.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# ---------- Seed defaults (optional — overridden per-org in /admin/settings) ----------
# DEFAULT_CURRENCY="USD"
# DEFAULT_PAYMENT_EXPIRY_HOURS="24"
# DEFAULT_ORDER_PREFIX="ORD"

# ---------- Legacy single-tenant branding (optional) ----------
# Only read when seeding the legacy Branding row. Self-serve tenants
# override these in /admin/branding. Safe to omit on a fresh deploy.
# CUSTOMER_BRAND_NAME="TraceTxn"
# SUPPORT_EMAIL="support@tracetxn.example.com"
# SUPPORT_PHONE="+1-555-0100"

# ---------- Session token lifetime (optional) ----------
# Format: <num><s|m|h|d>. Hard ceiling of 7d enforced regardless.
# JWT_EXPIRES_IN="12h"

# Optional dedicated secret for consent-flow tokens (defaults to
# JWT_SECRET when unset). Rotate to a separate value so a session-token
# leak can't forge consent tokens.
# CONSENT_TOKEN_SECRET=""

# ---------- Firebase (Google sign-in — main app AND console) ----------
# Server: single-line service-account JSON. When unset, Google sign-in is
# disabled everywhere and only the password / email-OTP paths work.
# FIREBASE_SERVICE_ACCOUNT=""
# Client (public) — the first four are all required for the Google button
# to render. Must be the same Firebase project as the service account.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# =========================================================================
# Platform super-admin console (/admin)
# =========================================================================
# The console used to be a separate Next.js app deployed from /admin with
# its own env. It is now part of THIS app and reads these from the same
# process env. Variables it shares with the main app — MONGODB_URI,
# MONGODB_DB, JWT_SECRET, SMTP_*, EMAIL_FROM_ACCOUNTS, EMAIL_REPLY_TO,
# COOKIE_SECURE, COOKIE_DOMAIN, FIREBASE_SERVICE_ACCOUNT and the
# NEXT_PUBLIC_FIREBASE_* set — are declared above and must NOT be
# duplicated here with different values.
#
# ⚠ The console sends its sign-in OTP over SMTP (nodemailer), not the
#   Resend HTTP path the main app uses. If SMTP_HOST / SMTP_USER /
#   SMTP_PASS are unset, `getMailer()` returns null and the OTP is only
#   logged — nobody can sign in to the console. Keep SMTP_* populated.

# NOTE: console access is NOT configured here. The `admin_users` collection
# is the only source of truth — add admins from /admin/admins. There is no
# environment allow-list; if every admin row is disabled, recovery is a
# direct insert into that collection.

# Dedicated signing key for the admin_session cookie. Defaults to
# JWT_SECRET when unset. Rotating it signs every operator out.
ADMIN_SESSION_SECRET=""

# Sessions / OTP tuning.
ADMIN_SESSION_TTL_HOURS="8"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# Base URL of this deployment. The console mints main-app links from it:
# the beta activation link (/activate?token=), the set-password link
# (/reset-password/<token>), and the impersonation handoff
# (/api/impersonate/start). Now the same origin the console runs on.
MAIN_APP_URL="https://tracetxn.com"

# Public URL of the console itself, used in the "you've been added"
# welcome email. Leave unset to derive ${MAIN_APP_URL}/admin — correct by
# construction now that the console is mounted here. Set it only to
# override (e.g. a vanity host that proxies to /admin).
# ADMIN_APP_URL=""

# Product name in console emails ("Your ___ sign-in code"). Kept separate
# from the main app's APP_NAME so one process can carry both.
ADMIN_APP_NAME="TraceTxn Admin"

# Shared secret for the founder-console impersonation handoff. The console
# signs a 60s single-use token; /api/impersonate/start verifies and burns
# it. MUST differ from JWT_SECRET. Unset = impersonation disabled.
IMPERSONATION_SECRET=""

# Display timezone for dates rendered in the console. Defaults to UTC so
# server and browser render identical text (no hydration mismatch).
# NEXT_PUBLIC_DISPLAY_TIMEZONE="UTC"
